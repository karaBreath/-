# ─── Claude API ────────────────────────────────────────────────────────────
# ถ้า login ด้วย `ant auth login` แล้ว ไม่ต้องตั้งค่านี้ก็ได้
ANTHROPIC_API_KEY=

# ─── สมอง (Claude) ─────────────────────────────────────────────────────────
THAIVOICE_MODEL=claude-opus-5
# low | medium | high | xhigh | max — เสียงคุยกันควรใช้ low/medium เพื่อลด latency
THAIVOICE_EFFORT=low
THAIVOICE_MAX_TOKENS=1024
# ชื่อผู้ช่วย (ใช้ในบทสนทนา)
THAIVOICE_ASSISTANT_NAME=ใจ
# เพศของ "ตัวผู้ช่วย" ไม่ใช่ของผู้ใช้ — กำหนดทั้งเสียงและคำลงท้าย ครับ/ค่ะ ของบอท
# ในภาษาไทยคำลงท้ายบอกเพศของคนพูด ไม่ใช่คนฟัง จึงต้องมาจากตัวบอทเอง
# female | male
THAIVOICE_ASSISTANT_GENDER=female
# โมเดลสำหรับงานเบื้องหลัง (สกัดความจำ/สรุป) — ปล่อยว่างเพื่อใช้ตัวเดียวกับข้างบน
THAIVOICE_MEMORY_MODEL=

# ─── ที่เก็บความจำ ─────────────────────────────────────────────────────────
THAIVOICE_DB=data/memory.db

# ─── เสียงเข้า (STT) ───────────────────────────────────────────────────────
# faster-whisper | google | azure | external
THAIVOICE_STT=faster-whisper
THAIVOICE_WHISPER_MODEL=large-v3
THAIVOICE_WHISPER_DEVICE=auto
THAIVOICE_WHISPER_COMPUTE=default

# ─── เสียงออก (TTS) ────────────────────────────────────────────────────────
# edge | gtts | azure | browser | none
THAIVOICE_TTS=edge
THAIVOICE_TTS_VOICE_FEMALE=th-TH-PremwadeeNeural
THAIVOICE_TTS_VOICE_MALE=th-TH-NiwatNeural
THAIVOICE_TTS_RATE=+8%

# ─── จำเสียงผู้พูด (speaker recognition) ───────────────────────────────────
# resemblyzer | speechbrain | none
THAIVOICE_SPEAKER_BACKEND=resemblyzer
# ความคล้ายขั้นต่ำที่จะถือว่า "คนเดิม" (0-1)
THAIVOICE_SPEAKER_THRESHOLD=0.75

# ─── ไมโครโฟน ──────────────────────────────────────────────────────────────
THAIVOICE_VAD_AGGRESSIVENESS=2
THAIVOICE_SILENCE_MS=800
THAIVOICE_MAX_UTTERANCE_S=30

# ─── เซิร์ฟเวอร์ ───────────────────────────────────────────────────────────
THAIVOICE_HOST=127.0.0.1
THAIVOICE_PORT=8080
# ปล่อยว่าง = อนุญาตทุก origin (dev เท่านั้น)
THAIVOICE_CORS_ORIGINS=
